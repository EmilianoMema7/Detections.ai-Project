alert http $HOME_NET any -> $EXTERNAL_NET any (msg:"NDR - Encrypted octet-stream POST beacon with nonce-prefixed payload and random path tokens (SynkLoader C2)"; flow:to_server,established; http.method; content:"POST"; http.header_names; content:"Content-Type"; http.header; content:"Content-Type|3A 20|application/octet-stream"; fast_pattern; http.uri; pcre:"/^\/[A-Za-z]{20,40}\/[A-Za-z0-9_-]+\/[A-Za-z]{20,40}$/"; http.request_body; isdataat:8; metadata: author detections.ai, created_at 2025-01-01, mitre_tactic_id TA0011, mitre_technique_id T1071.001, mitre_technique_id T1573.001; classtype:command-and-control; sid:1000201; rev:1;)
