alert dns $HOME_NET any -> any any (msg:"DGA-style domain query with high entropy label observed - possible C2 fallback"; dns.query; pcre:"/^(?=.{8,})(?:[bcdfghjklmnpqrstvwxyz]{4,}|[0-9a-z]*[0-9]{3,}[0-9a-z]*)/i"; threshold:type threshold, track by_src, count 10, seconds 60; classtype:command-and-control; metadata: mitre_technique_id T1568.002, mitre_technique_id T1071.004; sid:1000101; rev:1;)