// Detection: Credential access via browser files or keychain access
// Author: Security Expert
// Description: Monitors access to sensitive browser credential files and macOS keychain files
// MITRE ATT&CK: T1555 - Credentials from Password Stores
let BrowserAccess = DeviceProcessEvents
| where FolderPath contains "/Library/Application Support/"
| where (FolderPath has_any ("Google/Chrome", "Firefox", "BraveSoftware", "Microsoft Edge") or FolderPath contains "Cookies")
| where FileName in~ ("Login Data", "Cookies", "cookies.sqlite", "key4.db");
let KeychainAccess = DeviceProcessEvents
| where ProcessCommandLine has "security"
| where ProcessCommandLine has_any ("find-generic-password", "dump-keychain", "find-internet-password");
let FileAccess = DeviceFileEvents
| where FolderPath has_any ("login.keychain-db", "Keychains");
union BrowserAccess, KeychainAccess, FileAccess
| project TimeGenerated, DeviceName, AccountName, FileName, FolderPath, ProcessCommandLine