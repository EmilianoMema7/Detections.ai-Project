let NonStandardPaths = dynamic(["Downloads", "Temp", "AppData", "Users\\Public"]);
let KnownBrowsers = dynamic(["chrome.exe", "msedge.exe", "brave.exe", "firefox.exe"]);
let CredFileNames = dynamic(["Login Data", "Cookies", "Local State", "cookies.sqlite", "logins.json"]);
let SideloadSignal =
    DeviceImageLoadEvents
    | where FileName =~ "libcef.dll"
    | where InitiatingProcessFileName =~ "ClaudeDesktop.exe" or InitiatingProcessFileName has "jetbrains"
    | where InitiatingProcessFolderPath !contains "Program Files"
    | where InitiatingProcessFolderPath has_any (NonStandardPaths)
    | project Timestamp, DeviceName, InitiatingProcessFileName, InitiatingProcessFolderPath, ImagePath = FolderPath, FileName, Source = "FakeAgent_libcef_Sideload";
let CredTheftSignal =
    DeviceFileEvents
    | where FileName in (CredFileNames)
    | where FolderPath has "Users"
    | where InitiatingProcessFileName !in (KnownBrowsers)
    | project Timestamp, DeviceName, InitiatingProcessFileName, InitiatingProcessFolderPath, ImagePath = FolderPath, FileName, Source = "BrowserCredentialFileAccess";
SideloadSignal
| union CredTheftSignal
| sort by Timestamp desc