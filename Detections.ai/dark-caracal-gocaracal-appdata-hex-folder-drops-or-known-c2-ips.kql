let GoCaracalC2 = dynamic(["109.120.187.217","109.172.95.121","138.124.112.213","138.124.14.130","176.124.220.153","185.125.101.181","185.96.80.110","185.96.80.54","193.233.245.52","193.233.245.0","62.60.237.22","77.110.104.98","77.110.105.244","77.110.105.56","77.110.105.59","77.110.98.66","80.71.224.30","82.117.87.138","82.117.87.192","85.192.30.211","79.137.192.38","46.226.162.68","45.152.198.108"]);
let BandookC2 = dynamic(["91.208.197.80","91.208.184.45","91.208.206.88","91.208.184.130","176.123.1.174"]);
let AllC2 = array_concat(GoCaracalC2, BandookC2);
let HexFolderDrops = DeviceProcessEvents
| where FolderPath matches regex @"(?i).*\\AppData\\Roaming\\[0-9a-f]{8,16}\\[0-9a-f]{6,16}\.exe$"
| extend Source = "GoCaracal_AppDataHexDrop", RemoteIP = "", MatchedPath = FolderPath
| project TimeGenerated, DeviceName, Source, InitiatingProcessFileName, InitiatingProcessCommandLine, RemoteIP, MatchedPath;
let C2Network = DeviceNetworkEvents
| where RemoteIP in (AllC2)
| extend Source = iff(RemoteIP in (BandookC2), "Bandook_C2", "GoCaracal_C2"), MatchedPath = ""
| project TimeGenerated, DeviceName, Source, InitiatingProcessFileName, InitiatingProcessCommandLine, RemoteIP, MatchedPath;
HexFolderDrops
| union C2Network
| sort by TimeGenerated desc