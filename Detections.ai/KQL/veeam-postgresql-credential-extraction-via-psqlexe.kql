DeviceProcessEvents
| where FileName =~ "psql.exe"
| where ProcessCommandLine has "-U" and ProcessCommandLine has "postgres" and ProcessCommandLine has "VeeamBackup"
| where ProcessCommandLine has "-c" and ProcessCommandLine has "SELECT" and ProcessCommandLine has "user_name" and ProcessCommandLine has "password"
| extend WmiSpawned = (InitiatingProcessParentFileName =~ "WmiPrvSE.exe" or InitiatingProcessFileName =~ "WmiPrvSE.exe")
| extend PowerShellEncoded = (InitiatingProcessCommandLine has "powershell" and (InitiatingProcessCommandLine has "-enc" or InitiatingProcessCommandLine has "-EncodedCommand"))
| project TimeGenerated, DeviceName, AccountName, FileName, ProcessCommandLine, InitiatingProcessFileName, InitiatingProcessCommandLine, WmiSpawned, PowerShellEncoded
