alert tls $HOME_NET any -> $EXTERNAL_NET any (msg:"Outbound TLS session with self-signed certificate - possible validation bypass by malware client"; flow:to_server,established; tls.cert_subject; content:!""; tls.cert_issuer; content:!""; tls.cert_subject; pcre:"/^(.*)$/"; flowbits:set,tls.selfsigned.candidate; metadata: attack_id T1573, attack_id T1090; classtype:trojan-activity; sid:1000101; rev:1;)