DeviceFileEvents
| where FileName =~ "Login Data"
| where FolderPath has_any ("Google\\Chrome", "BraveSoftware\\Brave-Browser", "Microsoft\\Edge")
| where FolderPath contains "User Data"
| where InitiatingProcessFileName !in~ ("chrome.exe", "brave.exe", "msedge.exe")
| project TimeGenerated, DeviceName, InitiatingProcessFileName, InitiatingProcessFolderPath, InitiatingProcessCommandLine, FileName, FolderPath, ActionType